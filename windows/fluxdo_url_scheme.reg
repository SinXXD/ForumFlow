Windows Registry Editor Version 5.00

; ForumFlow URL Scheme Registration
; 双击此文件或在安装程序中导入以注册 forumflow:// URL scheme

[HKEY_CURRENT_USER\Software\Classes\forumflow]
@="URL:ForumFlow Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\forumflow\shell]

[HKEY_CURRENT_USER\Software\Classes\forumflow\shell\open]

[HKEY_CURRENT_USER\Software\Classes\forumflow\shell\open\command]
@="\"C:\\Program Files\\ForumFlow\\fluxdo.exe\" \"%1\""
